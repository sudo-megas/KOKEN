# (at your option) any later version.

export PYBUILD_NAME=koken

# The sizes hicolor expects. The supplied artwork is a single 2048px PNG with
# its corner rounding already applied; it is only ever scaled down.
ICON_SIZES = 512 256 128 64 48 32
MAGICK = $(shell command -v magick 2>/dev/null || command -v convert 2>/dev/null)

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# The helper is installed here rather than through debian/install, because
	# dh_install does not carry modes and this one file has to arrive 0755.
	# Everything else in the package is listed in debian/install as usual.
	install -d debian/koken/usr/lib/koken
	install -m0755 helper/koken-helper debian/koken/usr/lib/koken/koken-helper
	set -e; for size in $(ICON_SIZES); do \
		install -d debian/koken/usr/share/icons/hicolor/$${size}x$${size}/apps; \
		$(MAGICK) data/icons/koken.png -filter Lanczos \
			-resize $${size}x$${size} -strip \
			debian/koken/usr/share/icons/hicolor/$${size}x$${size}/apps/koken.png; \
	done

override_dh_installchangelogs:
	dh_installchangelogs --no-trim
